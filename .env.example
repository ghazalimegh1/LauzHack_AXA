# Copy this file to .env and put ONE key in. .env is in .gitignore: never commit it.
# Claude API (used first if set):
ANTHROPIC_API_KEY=
# or OpenRouter (one key for many providers, including Claude):
OPENROUTER_API_KEY=
# Optional: change models (check names with: python tools/check_models.py)
# Claude API defaults:  CHEAP_MODEL=claude-haiku-5-5   STRONG_MODEL=claude-sonnet-5-5
# OpenRouter defaults:  CHEAP_MODEL=google/gemini-2.5-flash-lite   STRONG_MODEL=google/gemini-2.5-flash
#                       NAIVE_MODEL=google/gemini-2.5-pro  (only for the 'send everything' comparison)
